<%- include('../../partials/header') %>

<main class="page-container">
  <h1 class="page-title">Daftar Ujian</h1>
  <p class="page-subtitle">Hanya ujian aktif yang dapat dikerjakan. Setiap ujian hanya boleh dikerjakan satu kali.</p>

  <% if (exams.length === 0) { %>
    <div class="empty-state">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
      <p>Belum ada ujian aktif saat ini.</p>
    </div>
  <% } else { %>
    <div class="exam-list">
      <% exams.forEach(function(exam) { %>
      <div class="exam-card">
        <div>
          <h3><%= exam.title %></h3>
          <p><%= exam.subject_name %></p>
          <p class="text-small">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align: -1px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= exam.duration_minutes %> menit ·
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align: -1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <%= exam.question_count %> soal
          </p>
        </div>
        <div class="exam-card-action">
          <% if (exam.attempt_status === 'submitted') { %>
            <span class="badge badge-success">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Selesai · <%= exam.attempt_score %>
            </span>
            <a href="/siswa/exams/<%= exam.id %>/result/<%= exam.attempt_id %>" class="btn btn-outline btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Lihat Nilai
            </a>
          <% } else if (exam.attempt_status === 'in_progress') { %>
            <a href="/siswa/exams/<%= exam.id %>/take/<%= exam.attempt_id %>" class="btn btn-primary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Lanjutkan
            </a>
          <% } else { %>
            <form action="/siswa/exams/<%= exam.id %>/start" method="POST" class="inline-form">
              <button type="submit" class="btn btn-primary btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Mulai Ujian
              </button>
            </form>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../../partials/footer') %>
