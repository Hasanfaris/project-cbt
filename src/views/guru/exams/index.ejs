<%- include('../../partials/header') %>

<style>
  /* Tombol Hapus Bertema Merah Lembut/Kustom */
  .btn-danger-custom {
    color: #ef4444 !important;
    border-color: rgba(239, 68, 68, 0.2) !important;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    transition: all 0.2s ease;
  }
  .btn-danger-custom:hover {
    background: rgba(239, 68, 68, 0.08) !important;
    border-color: #ef4444 !important;
    color: #ef4444 !important;
  }

  /* Struktur Dialog Konfirmasi Kustom (Bebas Alert Bawaan Browser) */
  .custom-confirm-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    animation: fadeIn 0.2s ease;
  }

  .custom-confirm-card {
    background: #ffffff;
    border-radius: 20px;
    width: 100%;
    max-width: 420px;
    padding: 24px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.1);
    transform: scale(0.95);
    animation: scaleUp 0.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .confirm-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .confirm-icon-danger {
    width: 40px;
    height: 40px;
    background: #fef2f2;
    color: #ef4444;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .confirm-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .confirm-text {
    font-size: 14px;
    color: #64748b;
    margin: 0 0 20px 0;
    line-height: 1.5;
  }

  .confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .btn-confirm-cancel {
    background: #f1f5f9;
    color: #475569;
    border: none;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-confirm-cancel:hover {
    background: #e2e8f0;
  }

  .btn-confirm-proceed {
    background: #ef4444;
    color: #ffffff;
    border: none;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-confirm-proceed:hover {
    background: #dc2626;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes scaleUp {
    to { transform: scale(1); }
  }
</style>

<main class="page-container">
  <div class="section-header">
    <div>
      <h1 class="page-title">Kelola Ujian</h1>
      <p class="page-subtitle" style="margin-bottom: 0;">Buat dan kelola ujian untuk siswa Anda.</p>
    </div>
    <a href="/guru/exams/create" class="btn btn-primary btn-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Buat Ujian
    </a>
  </div>

  <% if (exams.length === 0) { %>
    <div class="empty-state">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <p>Belum ada ujian. <a href="/guru/exams/create">Buat ujian pertama</a></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Judul</th>
            <th>Mapel</th>
            <th>Durasi</th>
            <th>Soal</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% exams.forEach(function(exam) { %>
          <tr>
            <td><strong><%= exam.title %></strong></td>
            <td><%= exam.subject_name %></td>
            <td><%= exam.duration_minutes %> mnt</td>
            <td><span class="badge badge-info"><%= exam.question_count %> soal</span></td>
            <td>
              <span class="badge <%= exam.is_active ? 'badge-success' : 'badge-muted' %>">
                <span class="badge-dot"></span>
                <%= exam.is_active ? 'Aktif' : 'Nonaktif' %>
              </span>
            </td>
            <td class="table-actions">
              <a href="/guru/exams/<%= exam.id %>/questions" class="btn btn-outline btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Soal
              </a>
              <a href="/guru/exams/<%= exam.id %>/edit" class="btn btn-outline btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Edit
              </a>
              <!-- Tombol Hapus Baru -->
              <button type="button" class="btn btn-outline btn-sm btn-danger-custom" onclick="openDeleteModal('<%= exam.id %>', '<%= exam.title %>')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  <line x1="10" y1="11" x2="10" y2="17"></line>
                  <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
                Hapus
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<!-- Hidden Form to trigger deletion -->
<form id="delete-exam-form" method="POST" style="display: none;"></form>

<!-- Modal Konfirmasi Hapus Modern -->
<div class="custom-confirm-backdrop" id="customDeleteModal">
  <div class="custom-confirm-card">
    <div class="confirm-header">
      <div class="confirm-icon-danger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h3 class="confirm-title">Hapus Ujian</h3>
    </div>
    <p class="confirm-text" id="deleteConfirmMessage">Apakah Anda yakin ingin menghapus ujian ini?</p>
    <div class="confirm-actions">
      <button type="button" class="btn-confirm-cancel" onclick="closeDeleteModal()">Batalkan</button>
      <button type="button" class="btn-confirm-proceed" id="confirmDeleteBtn">Ya, Hapus</button>
    </div>
  </div>
</div>

<script>
  let targetedExamId = null;

  function openDeleteModal(examId, examTitle) {
    targetedExamId = examId;
    const modal = document.getElementById('customDeleteModal');
    const msg = document.getElementById('deleteConfirmMessage');
    msg.innerHTML = `Apakah Anda yakin ingin menghapus ujian <strong>"${examTitle}"</strong>? Semua soal dan data yang terkait di dalamnya akan terhapus permanen.`;
    modal.style.display = 'flex';
  }

  function closeDeleteModal() {
    document.getElementById('customDeleteModal').style.display = 'none';
    targetedExamId = null;
  }

  document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (targetedExamId) {
      const form = document.getElementById('delete-exam-form');
      form.action = `/guru/exams/${targetedExamId}/delete`;
      form.submit();
    }
    closeDeleteModal();
  });
</script>

<%- include('../../partials/footer') %>