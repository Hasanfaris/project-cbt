<%- include('../../partials/header') %>

<main class="page-container">
  <a href="/guru/exams" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Kembali ke Ujian
  </a>

  <div class="section-header">
    <div>
      <h1 class="page-title">Soal: <%= exam.title %></h1>
      <p class="page-subtitle" style="margin-bottom: 0;"><%= exam.subject_name %> · <%= exam.duration_minutes %> menit</p>
    </div>
    <a href="/guru/exams/<%= exam.id %>/questions/create" class="btn btn-primary btn-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Tambah Soal
    </a>
  </div>

  <% if (questions.length === 0) { %>
    <div class="empty-state">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <p>Belum ada soal. <a href="/guru/exams/<%= exam.id %>/questions/create">Tambah soal pertama</a></p>
    </div>
  <% } else { %>
    <div class="question-list">
      <% questions.forEach(function(q, index) { %>
      <div class="question-item">
        <div class="question-header">
          <strong>Soal <%= index + 1 %></strong>
          <span class="badge badge-info"><%= q.points %> poin</span>
        </div>
        <p class="question-text"><%= q.question_text %></p>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
          <span class="question-meta">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
            <%= q.option_count %> pilihan jawaban
          </span>
          <form action="/guru/exams/<%= exam.id %>/questions/<%= q.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Hapus soal ini?')">
            <button type="submit" class="btn btn-danger btn-sm">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              Hapus
            </button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../../partials/footer') %>
